<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and newer.
   Everything is included except the phone's GPS position, which the privacy policy promises
   stays on the phone (UserPreferencesStore.DEVICE_LOCATION_PREFS_NAME).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lanka_weather_guard_device_location.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lanka_weather_guard_device_location.xml" />
    </device-transfer>
</data-extraction-rules>
