<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and older (Android 12+ uses data_extraction_rules.xml).
   Settings, saved places and the offline copy of forecasts are backed up, so they come back on a
   new phone. The phone's GPS position is not: the privacy policy promises it stays on the phone.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="lanka_weather_guard_device_location.xml" />
</full-backup-content>
