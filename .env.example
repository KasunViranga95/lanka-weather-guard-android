# Copy this file to .env (never commit .env).
#
# AI_PROXY_URL: address of your AI helper proxy (see server/ai-proxy/README.md). Used by all builds.
# The Gemini key lives on that server, not in the app.
# AI_PROXY_URL=https://lanka-weather-ai.<your-account>.workers.dev
#
# GEMINI_API_KEY: optional, for testing the AI helper in DEBUG builds only. Release builds ignore it.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
